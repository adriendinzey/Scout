# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- LLM -------------------------------------------------------------------
# Scout's Parse, Check, and Answer nodes call Claude. You supply your own key;
# see the "What this costs to run" section of the README.
ANTHROPIC_API_KEY=sk-ant-...

# Which backend the graph talks to:
#   anthropic - the real API (costs money)
#   fake      - deterministic canned responses; used by tests and CI
# Develop against `fake` and switch to `anthropic` for runs whose numbers you
# intend to publish.
SCOUT_LLM_BACKEND=anthropic

# Model IDs live in config, never hardcoded in the nodes. SCOUT_MODEL_AGENT is
# the one running the tool loop, so it is the one that decides which tool to
# call next; it is also the one called most often per query.
SCOUT_MODEL_PARSE=claude-haiku-4-5
SCOUT_MODEL_AGENT=claude-haiku-4-5
SCOUT_MODEL_ANSWER=claude-sonnet-5

# Refuse to start an evaluation run whose projected spend exceeds this (USD). A
# guard against a loop bug quietly emptying your account, not a billing control.
SCOUT_MAX_RUN_COST_USD=5.00

# --- Database --------------------------------------------------------------
SCOUT_DATABASE_URL=postgresql://scout:scout@localhost:5433/scout
# Each pooled connection decodes its own copy of the Brindle index (~172 MB for
# the London snapshot at 384 dims). Raise this only with that arithmetic in mind.
SCOUT_DB_POOL_SIZE=4

# Host port the Compose Postgres binds to. Only change it for a parallel sandbox.
SCOUT_DB_PORT=5433

# --- Embeddings ------------------------------------------------------------
SCOUT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCOUT_EMBEDDING_DIMS=384

# --- Retrieval -------------------------------------------------------------
# Brindle returns at most brindle.ef_search rows from a ranked scan, so this
# must be >= the candidate pool Scout asks for or LIMIT silently under-returns.
SCOUT_EF_SEARCH=100
SCOUT_CANDIDATE_POOL=100

# --- Agent loop ------------------------------------------------------------
# agent: Claude chooses which tool to call next (the default).
# fixed:  the hardcoded search-then-relax path, kept as the baseline the agent
#         is measured against.
SCOUT_MODE=agent

# What the code refuses to let the model do. Each of these is enforced in code
# and has a test proving it fires — a limit that lives only in a prompt is a
# suggestion. The loop stops when one is hit, and the answer says what it could
# not satisfy.
SCOUT_MAX_TOOL_CALLS=10
SCOUT_MAX_SEARCHES=4
SCOUT_MAX_QUERY_COST_USD=0.10
SCOUT_QUERY_TIMEOUT_S=60

# Fixed mode only: how few results count as thin, and how many times the rule
# relaxer may loosen a filter before answering with what it has.
SCOUT_THIN_RESULT_THRESHOLD=5
SCOUT_MAX_RELAXATIONS=3

# --- Tracing ---------------------------------------------------------------
# One JSONL file per run lands here, alongside the rows written to Postgres.
# Gitignored: a trace quotes listing and review text.
SCOUT_TRACE_DIR=runs

# Optional: correct token prices without editing code. Unset uses the built-in
# table in src/scout/llm/pricing.py.
# SCOUT_PRICE_TABLE=prices.toml

# Optional: mirror traces to LangSmith. Everything works without it, and no
# test depends on it. Setting this sends query, filter and listing text to a
# third party — leave it unset unless you want that.
# LANGSMITH_API_KEY=

# --- Data ------------------------------------------------------------------
# You download these yourself from insideairbnb.com/get-the-data — see
# docs/DATA.md. Nothing in Scout fetches them automatically.
SCOUT_LISTINGS_CSV=data/london/listings.csv.gz
SCOUT_REVIEWS_CSV=data/london/reviews.csv.gz
SCOUT_CITY=London
SCOUT_SNAPSHOT_DATE=
SCOUT_MAX_REVIEWS_PER_LISTING=5
