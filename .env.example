# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- LLM -------------------------------------------------------------------
# Scout's Parse, Check, and Answer nodes call Claude. You supply your own key;
# see the "What this costs to run" section of the README.
ANTHROPIC_API_KEY=sk-ant-...

# Which backend the graph talks to:
#   anthropic - the real API (costs money)
#   fake      - deterministic canned responses; used by tests and CI
# Develop against `fake` and switch to `anthropic` for runs whose numbers you
# intend to publish.
SCOUT_LLM_BACKEND=anthropic

# Model IDs live in config, never hardcoded in the nodes.
SCOUT_MODEL_PARSE=claude-haiku-4-5
SCOUT_MODEL_CHECK=claude-haiku-4-5
SCOUT_MODEL_ANSWER=claude-sonnet-5

# Refuse to start a run whose projected spend exceeds this (USD). A guard
# against a loop bug quietly emptying your account, not a billing control.
SCOUT_MAX_RUN_COST_USD=5.00

# --- Database --------------------------------------------------------------
SCOUT_DATABASE_URL=postgresql://scout:scout@localhost:5433/scout
# Each pooled connection decodes its own copy of the Brindle index (~172 MB for
# the London snapshot at 384 dims). Raise this only with that arithmetic in mind.
SCOUT_DB_POOL_SIZE=4

# Host port the Compose Postgres binds to. Only change it for a parallel sandbox.
SCOUT_DB_PORT=5433

# --- Embeddings ------------------------------------------------------------
SCOUT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCOUT_EMBEDDING_DIMS=384

# --- Retrieval -------------------------------------------------------------
# Brindle returns at most brindle.ef_search rows from a ranked scan, so this
# must be >= the candidate pool Scout asks for or LIMIT silently under-returns.
SCOUT_EF_SEARCH=100
SCOUT_CANDIDATE_POOL=100

# --- Agent loop ------------------------------------------------------------
SCOUT_THIN_RESULT_THRESHOLD=5
SCOUT_MAX_RELAXATIONS=3

# --- Data ------------------------------------------------------------------
# You download these yourself from insideairbnb.com/get-the-data — see
# docs/DATA.md. Nothing in Scout fetches them automatically.
SCOUT_LISTINGS_CSV=data/london/listings.csv.gz
SCOUT_REVIEWS_CSV=data/london/reviews.csv.gz
SCOUT_CITY=London
SCOUT_SNAPSHOT_DATE=
SCOUT_MAX_REVIEWS_PER_LISTING=5
